# Maintainer: Ciro Autuori <https://github.com/ciroautuori>
# This PKGBUILD tracks the main branch (latest commit). For stable releases
# use the openvidia package (tagged versions) when available.

pkgname=openvidia-git
pkgver=2.0.0.r0.gunknown
pkgrel=1
pkgdesc="Multi-key proxy for NVIDIA NIM with a native desktop dashboard — auto-rotation, cooldown, RPM limiting, Claude Code + Codex CLI + opencode support"
arch=('any')
url="https://github.com/ciroautuori/openvidia"
license=('MIT')
depends=(
    'python>=3.12'
    'python-fastapi'
    'python-uvicorn'
    'python-httpx'
    'python-psutil'
    'python-pywebview'
    # tomlkit is imported by the CLI helpers, and the Qt WebEngine backend is
    # what pywebview actually uses on this platform. Both were missing, so the
    # package installed cleanly and then failed at runtime with ImportError.
    'python-tomlkit'
    'python-pyqt6'
    'python-pyqt6-webengine'
    'webkit2gtk'
    'gobject-introspection'
)
optdepends=(
    'uv: faster dependency resolution'
)
# build() uses python-build and package() uses python-installer; neither was
# declared, so the build only worked on a machine that happened to have them —
# and fell back to `pip install --root`, which downloads from the network
# during package(), something a PKGBUILD must never do.
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel' 'git')
provides=('openvidia')
conflicts=('openvidia')
source=("$pkgname::git+https://github.com/ciroautuori/openvidia.git")
md5sums=('SKIP')

pkgver() {
    cd "$srcdir/$pkgname"
    # A -git package must produce a NEW version for every commit, or pacman -Syu
    # never offers an update. Reading pyproject.toml returned the same string
    # until someone bumped it by hand, which for a branch-tracking package is
    # effectively never. Base it on the commit, keeping the declared version as
    # the human-readable prefix.
    local base
    base=$(grep -m1 '^version' pyproject.toml | sed 's/.*"\(.*\)"/\1/')
    printf "%s.r%s.g%s" \
        "${base:-0.0.0}" \
        "$(git rev-list --count HEAD)" \
        "$(git rev-parse --short HEAD)"
}

build() {
    cd "$srcdir/$pkgname"
    python -m build --wheel --no-isolation
}

package() {
    cd "$srcdir/$pkgname"

    python -m installer --destdir="$pkgdir" dist/*.whl

    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

    # The desktop entry ships with Exec=openvidia, which resolves because the
    # wheel installs that entry point to /usr/bin. The previous revision shipped
    # an entry pointing at openvidia-launcher.sh — a script this package never
    # installed anywhere — so the menu item did nothing at all.
    install -Dm644 openvidia.desktop "$pkgdir/usr/share/applications/openvidia.desktop"
    install -Dm644 openvidia/web/assets/logo.png \
        "$pkgdir/usr/share/icons/hicolor/256x256/apps/openvidia.png"
}
